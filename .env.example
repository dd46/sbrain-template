OPENAI_MODEL=qwen3.6:35b-a3b

# OpenAI (cloud) — comment Ollama block above and use:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
