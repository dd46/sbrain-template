NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
DOCS_ROOT=docs
# Catalog root (default: $DOCS_ROOT/knowledge-base)
# KB_ROOT=docs/knowledge-base

# Ollama (OpenAI-compatible). Pull model first:
#   ollama pull qwen3.6:35b-a3b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen3.6:35b-a3b

# TokenRouter — DeepSeek Pro in the chat UI
# https://api.tokenrouter.com/v1  model: deepseek-v4-pro
TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TOKENROUTER_MODEL=deepseek-v4-pro

# Default provider for chat when the UI does not send one: ollama | deepseek_pro
# CHAT_PROVIDER=ollama
