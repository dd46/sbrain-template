{
  "name": "sbrain-template",
  "version": "1.0.0",
  "description": "Second Brain — Markdown catalog synced to Neo4j with MCP tools for Cursor",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync_to_neo4j.js",
    "kb:promote": "node scripts/kb_promote.js",
    "mcp": "node mcp_server/server.js",
    "chat": "npm run dev --prefix web",
    "test": "node --test tests/parse-catalog.test.js tests/chat-agent.test.js tests/docs-fs.test.js tests/conversation-persist.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/sync-graph.test.js tests/integration/kb-tools.test.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/openai": "^1.5.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xenova/transformers": "^2.17.2",
    "gray-matter": "^4.0.3",
    "langchain": "^1.5.9",
    "neo4j-driver": "^5.28.1",
    "zod": "^3.25.76"
  }
}
